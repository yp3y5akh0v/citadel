<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Keep UpgradeCode stable across releases. -->
  <Package Name="Citadel Studio"
           Manufacturer="Yuriy Peysakhov"
           Version="$(Version)"
           UpgradeCode="6f3a1d94-2c85-4e17-9b0a-7d4e5c1f8a20"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Citadel Studio is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Icon.SourceFile embeds the whole file; use an .ico, not the executable. -->
    <Icon Id="StudioIcon" SourceFile="icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="StudioIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://citadeldb.dev" />
    <Property Id="ARPHELPLINK" Value="https://github.com/yp3y5akh0v/citadel" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="Citadel Studio">
        <Directory Id="LICENSEFOLDER" Name="Licences" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StudioMenuFolder" Name="Citadel Studio" />
    </StandardDirectory>

    <Feature Id="Main" Title="Citadel Studio" Level="1">
      <ComponentGroupRef Id="StudioFiles" />
    </Feature>

    <ComponentGroup Id="StudioFiles" Directory="INSTALLFOLDER">
      <Component Id="StudioExe" Guid="9c1e7b52-4a63-4f8d-8e21-3b6c0d9f4e77">
        <File Id="StudioExeFile" Source="citadel-studio.exe" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\CitadelDB\Studio"
                       Name="executable"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
      <Component Id="StudioLicences" Guid="4b7e0c31-9d26-4a85-b3f1-2e8a6c0d5b94"
                 Directory="LICENSEFOLDER">
        <File Id="LicenceApache" Source="LICENSE-APACHE" />
        <File Id="LicenceInter" Source="Inter-OFL.txt" />
        <File Id="LicenceJetBrains" Source="JetBrainsMonoNL-OFL.txt" />
        <File Id="LicenceEguiFonts" Source="EguiDefaultFonts-Licenses.txt" />
        <File Id="ThirdPartyNotices" Source="THIRD_PARTY_NOTICES.md" />
        <File Id="SqlJsonPathNotice" Source="sql-json-path-NOTICE.txt" />
        <File Id="ThirdPartyLicenses" Source="THIRD_PARTY_LICENSES.html" />
        <RemoveFolder Id="RemoveLicenceFolder" Directory="LICENSEFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\CitadelDB\Studio"
                       Name="licences"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
      <Component Id="StudioShortcut" Guid="1d8f2a06-5b74-4c93-a0e5-8f2b7c4d6a19"
                 Directory="StudioMenuFolder">
        <Shortcut Id="StudioStartMenu"
                  Name="Citadel Studio"
                  Description="Read an encrypted vault and prove what has happened to it"
                  Target="[INSTALLFOLDER]citadel-studio.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="StudioIcon" />
        <RemoveFolder Id="RemoveStudioMenuFolder" Directory="StudioMenuFolder" On="uninstall" />
        <!-- The shortcut component requires a per-user registry KeyPath. -->
        <RegistryValue Root="HKCU"
                       Key="Software\CitadelDB\Studio"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Package>
</Wix>
